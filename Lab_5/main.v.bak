`timescale 1ns/1ps

module main (
    input  [17:0] SW,
    input  [3:0]  KEY,
    output [17:0] LEDR
);

    reg  [7:0] A;
    reg  [7:0] S;
    reg        Overflow;

    wire [7:0] sum;
    wire       carry;

    // Nine-bit addition preserves the carry out of the eight-bit sum.
    assign {carry, sum} = {1'b0, A} + {1'b0, S};

    // Figure 2: input, accumulator, and carry registers share the clock.
    // KEY0 resets all registers immediately when driven low.
    always @(posedge KEY[1] or negedge KEY[0]) begin
        if (!KEY[0]) begin
            A        <= 8'b00000000;
            S        <= 8'b00000000;
            Overflow <= 1'b0;
        end
        else begin
            A        <= SW[7:0];
            S        <= sum;
            Overflow <= carry;
        end
    end

    assign LEDR[7:0]  = S;
    assign LEDR[8]    = Overflow;
    assign LEDR[17:9] = 9'b000000000;

endmodule
